# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# 含真实学生/家长信息的原始样例，不提交到 Git
/样例（按时间升序）.md

# 素材原图，已移出仓库
/material/

# local PGlite database
/.data/

# local UI test artifacts
/.tmp-test/

# eval reports are generated locally; commit a baseline separately if needed
/eval/report.md
/eval/report.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next dev 自动生成，不入库
/AGENTS.md
