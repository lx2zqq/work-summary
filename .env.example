# DeepSeek（项目专用变量名，避免和系统里已有的 DEEPSEEK_API_KEY 冲突）
REVIEW_DEEPSEEK_API_KEY=
REVIEW_DEEPSEEK_MODEL=deepseek-flash
REVIEW_DEEPSEEK_BASE_URL=https://api.deepseek.com
# 工具调用模式：auto 优先让模型自主查询，模型不支持时自动降级；off 强制全量预注入
REVIEW_TOOLS_MODE=auto

# 语音转文字（硅基流动 SiliconFlow，免费模型需实名认证）
# 不配置也能用：安卓微信等不支持网页语音识别的环境会提示直接打字
REVIEW_ASR_API_KEY=
REVIEW_ASR_BASE_URL=https://api.siliconflow.cn/v1
REVIEW_ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# 登录密码（服务端校验）
APP_PASSWORD=
# 登录 Cookie 签名密钥，生成方式：openssl rand -hex 32
AUTH_SECRET=

# 生产环境填 Supabase 连接串；本地留空则使用 .data/pglite
DATABASE_URL=
# 可选：本地 PGlite 数据目录
PGLITE_DATA_DIR=

# 可选：定时推进记忆生命周期（POST /api/cron/memories-lifecycle）
# 不配置也能靠惰性流转正常工作，接口会返回 503
CRON_SECRET=
